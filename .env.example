# Required
OPENAI_API_KEY=

# Optional: live news (without it the News agent shows clearly-labelled sample items)
TAVILY_API_KEY=

# Reserved for future providers (not used yet)
GOOGLE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Login (single owner, no sign-up). Create with: python -m scripts.set_password --email you@example.com --write-env
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
